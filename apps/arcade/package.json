{
  "name": "arcade",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.0.0 <23.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm run build",
    "smoke:evidence": "node ./scripts/evidence-viewer-smoke.mjs",
    "check:links": "node ./scripts/check-internal-links.mjs",
    "claims:lint": "node ./scripts/claims-lint.mjs",
    "check:site-hosts": "node ./scripts/validate-site-hosts.mjs",
    "build:oss": "SITE_HOST_OVERRIDE=reach-cli.com next build",
    "build:enterprise": "SITE_HOST_OVERRIDE=ready-layer.com next build",
    "check:mode-links": "node ./scripts/check-mode-links.mjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.10.1",
    "better-sqlite3": "^13.0.2",
    "ioredis": "^6.0.0",
    "next": "16.2.12",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "stripe": "^22.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.24",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^10.9.1",
    "eslint-config-next": "^16.0.0",
    "postcss": "^8.5.23",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "minimatch": "^10.2.5",
    "sharp": "^0.35.0",
    "postcss": "$postcss"
  }
}